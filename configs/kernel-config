# 启用高通 SDM845/SDM850 平台支持
CONFIG_ARCH_QCOM=y
CONFIG_ARCH_SDM845=y

# 启用必要的驱动
CONFIG_DRM_MSM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_USB_HS=y
CONFIG_PHY_QCOM_USB_HSIC=y

# 启用 UFS 存储支持
CONFIG_SCSI_UFS_QCOM=y

# 启用触摸屏支持 (Goodix)
CONFIG_TOUCHSCREEN_GOODIX=y

# 启用 WiFi/蓝牙 (QCA6174)
CONFIG_ATH10K=y
CONFIG_ATH10K_PCI=y
CONFIG_BT_QCA=y
